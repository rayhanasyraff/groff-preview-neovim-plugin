#!/usr/bin/env bash

set -u

if [[ $# -lt 1 ]]; then
    echo "Usage: groff-preview file.ms"
    exit 1
fi

src="$(realpath "$1")"
pdf="${src%.*}.pdf"
tmp="$(mktemp -d)"

page=1
zoom=1
panx=0
pany=0
last=""

cleanup() {
    rm -rf "$tmp"
}
trap cleanup EXIT INT TERM

compile_pdf() {
    if ! groff -ms -Tpdf "$src" > "$tmp/output.pdf" 2>"$tmp/error"; then
        clear
        echo "GROFF COMPILATION ERROR"
        cat "$tmp/error"
        return 1
    fi

    mv "$tmp/output.pdf" "$pdf"
    pages=$(pdfinfo "$pdf" | awk '/^Pages:/ {print $2}')
    [[ "$pages" =~ ^[0-9]+$ ]] || pages=1

    (( page > pages )) && page=$pages
    return 0
}

render_page() {
    local dpi=$((110 * zoom))

    pdftoppm -f "$page" -l "$page" -singlefile \
        -r "$dpi" -png "$pdf" "$tmp/page" \
        >/dev/null 2>&1 || return 1

    read -r width height < <(
        identify -format '%w %h' "$tmp/page.png"
    )

    local vw=900
    local vh=650

    local maxx=$((width-vw))
    local maxy=$((height-vh))

    (( maxx < 0 )) && maxx=0
    (( maxy < 0 )) && maxy=0

    (( panx < 0 )) && panx=0
    (( pany < 0 )) && pany=0
    (( panx > maxx )) && panx=$maxx
    (( pany > maxy )) && pany=$maxy

    convert "$tmp/page.png" \
        -crop "${vw}x${vh}+${panx}+${pany}" \
        +repage "$tmp/view.png"

    clear
    echo "GROFF PREVIEW"
    echo "File: $(basename "$src")"
    echo "Page: $page/$pages | Zoom: ${zoom}x"
    echo
    echo "n/p: Page | +/-: Zoom | h/j/k/l: Pan"
    echo "r: Refresh | q: Quit"
    echo

    img2sixel "$tmp/view.png"
}

if ! compile_pdf; then
    read -r -p "Press Enter to exit..."
    exit 1
fi

last="$(stat -c '%y:%s' "$src")"

while true; do
    render_page

    while true; do
        if read -rsn1 -t 0.25 key; then
            case "$key" in
                q) exit 0 ;;
                n)
                    if (( page < pages )); then
                        ((page++))
                        panx=0
                        pany=0
                        break
                    fi
                    ;;
                p)
                    if (( page > 1 )); then
                        ((page--))
                        panx=0
                        pany=0
                        break
                    fi
                    ;;
                +|=)
                    if (( zoom < 4 )); then
                        ((zoom++))
                        panx=0
                        pany=0
                        break
                    fi
                    ;;
                -)
                    if (( zoom > 1 )); then
                        ((zoom--))
                        panx=0
                        pany=0
                        break
                    fi
                    ;;
                h) ((panx-=120)); break ;;
                l) ((panx+=120)); break ;;
                k) ((pany-=120)); break ;;
                j) ((pany+=120)); break ;;
                r)
                    last=""
                    break
                    ;;
            esac
        fi

        current="$(stat -c '%y:%s' "$src")"

        if [[ "$current" != "$last" ]]; then
            if compile_pdf; then
                last="$current"
                panx=0
                pany=0
            fi
            break
        fi
    done
done
