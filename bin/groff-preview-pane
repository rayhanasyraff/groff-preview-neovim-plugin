#!/usr/bin/env bash
# PDF/image viewer pane opened by :GroffPreview (lua/groff-preview/pane.lua).
# Re-renders when the file changes or the pane is resized.
#
# WezTerm (sharp, iTerm2 image protocol):
#   mouse wheel        scroll (continues onto next/previous page)
#   Ctrl + wheel       zoom in/out at the mouse pointer
#   Alt + wheel        scroll sideways (WezTerm keeps Shift+wheel for itself)
#   + / -              zoom in/out        z  fit page / fit width
#   h j k l, arrows    pan                g / G  top / bottom of page
#   n / p, PgDn/PgUp   next / previous page
#   r redraw, q quit
# Windows Terminal / tmux (sixel, lower resolution): n/p page, r, q.
#
# Usage: groff-preview-pane [--owner PID] FILE [PAGE]
#   --owner PID   exit (closing the pane) when process PID (Neovim) is gone
set -u
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"   # panes may start without ~/.profile
owner=""
if [[ "${1:-}" == "--owner" ]]; then owner="${2:-}"; shift 2; fi
file="$(realpath "$1")"
page="${2:-1}"
cw="${GROFF_PREVIEW_CELL_W:-10}"
ch="${GROFF_PREVIEW_CELL_H:-20}"
tmp="$(mktemp -d)"

wez=0
[[ "${TERM_PROGRAM:-}" == "WezTerm" && -z "${TMUX:-}" ]] && wez=1

# One viewer per file: the plugin checks this pidfile before opening another pane.
piddir="/tmp/groff-preview-pane-$(id -u)"
mkdir -p "$piddir"
pidfile="$piddir/$(printf '%s' "$file" | sha256sum | cut -c1-64).pid"
echo $$ > "$pidfile"
cleanup() {
    (( wez )) && printf '\033[?1000l\033[?1006l'
    rm -rf "$tmp"; rm -f "$pidfile"
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
stty -echo 2>/dev/null
(( wez )) && printf '\033[?1000h\033[?1006h'      # mouse reporting (SGR)

pane_size() {   # prints "cols rows"
    if [[ -n "${TMUX:-}" ]]; then
        tmux display -p -t "${TMUX_PANE:-}" '#{pane_width} #{pane_height}'
    else
        local r c; read -r r c < <(stty size 2>/dev/null); echo "${c:-80} ${r:-24}"
    fi
}

is_pdf=0; [[ "${file,,}" == *.pdf ]] && is_pdf=1
pages=1
count_pages() {
    (( is_pdf )) || { pages=1; return 0; }
    local n; n=$(pdfinfo "$file" 2>/dev/null | awk '/^Pages:/ {print $2}')
    [[ "$n" =~ ^[0-9]+$ ]] || return 1
    pages=$n; (( page > pages )) && page=$pages; return 0
}

# ---------------------------------------------------------------- sixel mode
render_sixel() {
    local cols rows w h src
    read -r cols rows < <(pane_size)
    w=$(( cols * cw )); h=$(( (rows - 2) * ch ))      # header + spare line
    printf '\033[H\033[2J\033[3J'
    if [[ ! -s "$file" ]]; then echo "waiting for $file ..."; return; fi
    count_pages || { echo "unreadable PDF (still being written?)"; return; }
    if (( is_pdf )); then
        pdftoppm -f "$page" -l "$page" -singlefile -png \
            -scale-to-x "$w" -scale-to-y -1 "$file" "$tmp/page" 2>/dev/null \
            || { echo "pdftoppm failed"; return; }
        src="$tmp/page.png"
    else
        src="$file[0]"
    fi
    printf '%s  [%s/%s]  n/p page  q quit\n' "$(basename "$file")" "$page" "$pages"
    magick "$src" -background white -flatten -resize "${w}x${h}>" sixel:- 2>/dev/null \
        || echo "render failed"
}

# -------------------------------------------------------------- WezTerm mode
# fitpage=1: whole page. Otherwise vis = visible % of page width (100 = fit
# width) and panx/pany = viewport offset in rendered pixels.
fitpage=1; vis=100; panx=0; pany=0
cellpx=14                              # rendered px per column (~physical)
cratio="${GROFF_PREVIEW_CELL_RATIO:-2.1}"    # cell height / width
rowpx=$(awk -v c="$cellpx" -v r="$cratio" 'BEGIN{printf "%d", c*r}')
iw=1; ih=1; dispw=1; disph=1           # last rendered page / displayed size
cache_key=""; anchor=""; mtime=""

# Render the current page at width $1 into $tmp/page.png (cached).
page_png() {
    local key="$page:$1:$mtime"
    [[ "$key" == "$cache_key" ]] && return 0
    if (( is_pdf )); then
        pdftoppm -f "$page" -l "$page" -singlefile -png \
            -scale-to-x "$1" -scale-to-y -1 "$file" "$tmp/page" 2>/dev/null || return 1
    else
        magick "$file[0]" -background white -flatten -resize "${1}x" "$tmp/page.png" 2>/dev/null || return 1
    fi
    read -r iw ih < <(identify -format '%w %h' "$tmp/page.png")
    cache_key="$key"
}

render_wezterm() {
    local cols rows avail vw vh rw src dim label
    read -r cols rows < <(pane_size)
    avail=$(( rows - 2 )); (( avail < 1 )) && avail=1
    vw=$(( cols * cellpx )); vh=$(( avail * rowpx ))
    if [[ ! -s "$file" ]]; then printf '\033[H\033[2J'; echo "waiting for $file ..."; return; fi
    count_pages || { printf '\033[H\033[2J'; echo "unreadable PDF (still being written?)"; return; }
    if (( fitpage )); then rw=$(( vw * 2 )); else rw=$(( vw * 100 / vis )); fi
    page_png "$rw" || { printf '\033[H\033[2J'; echo "render failed"; return; }

    if (( fitpage )); then
        src="$tmp/page.png"; label="fit"
        # give WezTerm one dimension only, so the aspect ratio is kept
        if (( avail * rowpx * iw / ih <= vw )); then
            dim="height=$avail"; disph=$vh; dispw=$(( vh * iw / ih ))
        else
            dim="width=$cols"; dispw=$vw; disph=$(( vw * ih / iw ))
        fi
    else
        if [[ -n "$anchor" ]]; then             # keep the point under the mouse
            read -r panx pany < <(awk -v a="$anchor" -v iw="$iw" -v ih="$ih" -v c="$cellpx" -v r="$rowpx" \
                'BEGIN{split(a,v," "); printf "%d %d", v[1]*iw-(v[3]-1)*c, v[2]*ih-(v[4]-2)*r}')
            anchor=""
        fi
        (( panx > iw - vw )) && panx=$(( iw - vw )); (( panx < 0 )) && panx=0
        (( pany > ih - vh )) && pany=$(( ih - vh )); (( pany < 0 )) && pany=0
        magick "$tmp/page.png" -crop "${vw}x${vh}+${panx}+${pany}" +repage \
            -background white -extent "${vw}x${vh}" "$tmp/view.png"
        src="$tmp/view.png"; dim="width=$cols"; label="$(( 10000 / vis ))%"
        dispw=$vw; disph=$vh
    fi
    printf '\033[H\033[2J\033[3J'
    printf '%s %s/%s %s  wheel/Ctrl+wheel z q\n' "$(basename "$file")" "$page" "$pages" "$label" | cut -c1-"$cols"
    printf '\033]1337;File=inline=1;%s;preserveAspectRatio=1:%s\a' "$dim" "$(base64 -w0 "$src")"
}

# Fractions of the page under pane cell (x,y): prints "fx fy".
point_on_page() {
    awk -v x="$1" -v y="$2" -v fp="$fitpage" -v px="$panx" -v py="$pany" -v iw="$iw" -v ih="$ih" \
        -v dw="$dispw" -v dh="$disph" -v c="$cellpx" -v r="$rowpx" 'BEGIN{
        sx=(x-1)*c; sy=(y-2)*r; if (sy<0) sy=0
        if (fp) { fx=sx/dw; fy=sy/dh } else { fx=(px+sx)/iw; fy=(py+sy)/ih }
        if (fx<0) fx=0; if (fx>1) fx=1; if (fy<0) fy=0; if (fy>1) fy=1
        printf "%f %f", fx, fy }'
}

# Zoom in (+1) or out (-1), keeping page point under cell (x,y) in place.
zoom() {
    local dir=$1 x=$2 y=$3 f
    f=$(point_on_page "$x" "$y")
    if (( dir > 0 )); then
        if (( fitpage )); then fitpage=0; vis=100
        elif (( vis > 20 )); then vis=$(( vis * 2 / 3 )); fi
    else
        (( fitpage )) && return
        if (( vis >= 100 )); then fitpage=1; panx=0; pany=0; return; fi
        vis=$(( vis * 3 / 2 )); (( vis > 100 )) && vis=100
    fi
    anchor="$f $x $y"
}

scroll() {   # $1 = +1 down / -1 up; continues onto next/previous page
    local cols rows step; read -r cols rows < <(pane_size)
    step=$(( (rows - 2) * rowpx / 6 ))
    if (( fitpage )); then
        if (( $1 > 0 && page < pages )); then ((page++)); elif (( $1 < 0 && page > 1 )); then ((page--)); fi
        return
    fi
    local vh=$(( (rows - 2) * rowpx ))
    if (( $1 > 0 )); then
        if (( pany >= ih - vh )); then (( page < pages )) && { ((page++)); pany=0; }
        else pany=$(( pany + step )); fi
    else
        if (( pany <= 0 )); then (( page > 1 )) && { ((page--)); pany=999999; }
        else pany=$(( pany - step )); fi
    fi
}

pan_x() { local cols rows; read -r cols rows < <(pane_size); panx=$(( panx + $1 * cols * cellpx / 6 )); }

center() { local cols rows; read -r cols rows < <(pane_size); echo "$(( cols / 2 )) $(( rows / 2 ))"; }

# -------------------------------------------------------------------- input
# Reads one key/mouse event into EV (e.g. "key j", "wheel 65 10 5", "up").
read_event() {
    local t=$1 k c seq=""
    EV=""
    IFS= read -rsn1 -t "$t" k || return 1
    if [[ "$k" != $'\e' ]]; then EV="key $k"; return 0; fi
    IFS= read -rsn1 -t 0.02 c || { EV="key esc"; return 0; }
    [[ "$c" == "[" || "$c" == "O" ]] || { EV="key esc"; return 0; }
    local code
    while IFS= read -rsn1 -t 0.02 c; do
        seq+="$c"; printf -v code '%d' "'$c"
        (( code >= 64 && code <= 126 )) && break     # final byte of CSI
    done
    case "$seq" in
        A) EV="key k" ;; B) EV="key j" ;; C) EV="key l" ;; D) EV="key h" ;;
        5~) EV="key p" ;; 6~) EV="key n" ;; H|1~) EV="key g" ;; F|4~) EV="key G" ;;
        \<*M)
            local b x y; IFS=';' read -r b x y <<< "${seq:1:${#seq}-2}"
            EV="mouse $b $x $y" ;;
        *) EV="" ;;
    esac
    return 0
}

# Applies one event; returns 0 if the view changed.
apply_event() {
    set -- $EV
    case "$1" in
        key)
            case "$2" in
                q) exit 0 ;;
                r) cache_key="" ;;
                n) (( page < pages )) && { ((page++)); pany=0; } ;;
                p) (( page > 1 )) && { ((page--)); pany=0; } ;;
                *)
                    (( wez )) || return 1
                    case "$2" in
                        +|=) zoom 1 $(center) ;;
                        -)   zoom -1 $(center) ;;
                        z)   if (( fitpage )); then fitpage=0; vis=100; else fitpage=1; fi; panx=0; pany=0 ;;
                        j) scroll 1 ;;  k) scroll -1 ;;
                        h) pan_x -1 ;;  l) pan_x 1 ;;
                        g) pany=0 ;;    G) pany=999999 ;;
                        *) return 1 ;;
                    esac ;;
            esac ;;
        mouse)
            case "$2" in
                64) scroll -1 ;;  65) scroll 1 ;;            # wheel
                80) zoom 1 "$3" "$4" ;;  81) zoom -1 "$3" "$4" ;;   # Ctrl + wheel
                72|68) pan_x -1 ;;  73|69) pan_x 1 ;;        # Alt (or Shift) + wheel
                *) return 1 ;;
            esac ;;
        *) return 1 ;;
    esac
    return 0
}

render() { if (( wez )); then render_wezterm; else render_sixel; fi; }

size_now() { pane_size; }
last_mtime=""; last_size=""
while true; do
    # Close together with the Neovim that opened us.
    if [[ -n "$owner" ]] && ! kill -0 "$owner" 2>/dev/null; then exit 0; fi
    cur_mtime="$(stat -c %Y.%s "$file" 2>/dev/null)"
    cur_size="$(size_now)"
    if [[ "$cur_mtime" != "$last_mtime" ]]; then
        [[ -n "$last_mtime" ]] && sleep 0.2     # let writers finish
        mtime="$(stat -c %Y.%s "$file" 2>/dev/null)"; cache_key=""
        render; last_mtime="$mtime"; last_size="$cur_size"
    elif [[ "$cur_size" != "$last_size" ]]; then
        render; last_size="$cur_size"
    fi
    if read_event 0.5; then
        changed=0
        [[ -n "$EV" ]] && apply_event && changed=1
        while read_event 0.03; do            # coalesce bursts (wheel spins)
            [[ -n "$EV" ]] && apply_event && changed=1
        done
        (( changed )) && render
    fi
done
